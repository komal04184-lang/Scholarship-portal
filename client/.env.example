# ApexScholar Frontend Environment Configuration
# API Base URL (defaults to /api/v1 for reverse proxy or gateway)
VITE_API_BASE_URL=/api/v1

# In development, the Vite dev server proxies requests:
# - /api/v1/applications -> Application Service (http://localhost:3003)
# - /api/v1/auth, /api/v1/profile, /api/v1/admin -> Identity Service (http://localhost:3001)
# - /api/reviews -> Review Service (http://localhost:3004)
# - /api/v1/scholarships -> Scholarship Service / Gateway (http://localhost:3002)

