# Application Microservice Configuration Example
PORT=3003
NODE_ENV=development

# Independent PostgreSQL Database (application_db)
# Must connect only to application_db, never the monolithic or shared database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=application_db
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@localhost:5432/application_db
PG_POOL_MAX=20

# Microservices Communication URLs
IDENTITY_SERVICE_URL=http://localhost:3001
SCHOLARSHIP_SERVICE_URL=http://localhost:3002
REVIEW_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
FALLBACK_ELIGIBILITY_CHECK=true

# Service-to-Service Secret Token
SERVICE_TO_SERVICE_SECRET=your_internal_service_secret_token

# JWT Authentication (Matching Identity Service)
JWT_SECRET=your_shared_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=24h

# Document Storage (Secure Local Filesystem)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
