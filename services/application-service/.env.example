# Application Service Environment Configuration
PORT=3002
NODE_ENV=development

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=scholarship_portal
PGUSER=postgres
PGPASSWORD=replace_with_your_password
# Application service schema (can run in public or dedicated portal/application schema)
PG_SCHEMA=public

# MongoDB Configuration (for rich document metadata & application snapshots)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=scholarship_documents

# JWT Authentication (shared secret or verification with Auth Service)
JWT_SECRET=dev_jwt_secret_change_in_production_k9x2m4p7
JWT_EXPIRES_IN=7d

# Microservice Endpoints (configurable per environment)
STUDENT_SERVICE_URL=http://localhost:3000
SCHOLARSHIP_SERVICE_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Fallback Mode when dependent services are starting up / offline in local dev
FALLBACK_ELIGIBILITY_CHECK=true

