# Application Microservice Environment Configuration
PORT=3003
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:Kom@l007@localhost:5432/scholarship_portal
PGHOST=localhost
PGPORT=5432
PGDATABASE=scholarship_portal
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PG_SCHEMA=public
PG_POOL_MAX=20

# Document Snapshots & Flexible Metadata (MongoDB)
