PORT=3001
NODE_ENV=development

# Independent PostgreSQL Database (identity_db)
# Must connect only to identity_db, never the monolithic or shared database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/identity_db

# Shared JWT Secret (must match other microservices)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d

# Microservice URLs
APPLICATION_SERVICE_URL=http://localhost:3003
SCHOLARSHIP_SERVICE_URL=http://localhost:3002
REVIEW_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
FRONTEND_URL=http://localhost:5173

