PORT=3004
# PostgreSQL is recommended for integrated/project demonstration.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/scholarship_review
DB_AUTO_INIT=true
PGSSL=false

# Must match the JWT signing secret used by Identity Service (HS256).
JWT_SECRET=replace_with_the_same_identity_service_jwt_secret

# Must match INTERNAL_SERVICE_TOKEN in Application Service.
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_shared_service_token
APPLICATION_SERVICE_URL=http://localhost:3003
APPLICATION_SERVICE_TIMEOUT_MS=5000
